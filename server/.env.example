# Optional. Without a server/.env file the API uses a database on your own computer:
# MySQL on localhost:3306, user root, no password, database surviving_france.
# Copy this file to server/.env only if your local MySQL needs different values.

# PORT=3000
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=surviving_france
# JWT_SECRET=any-long-random-text
